# Copy to deployment/.env (not committed) and fill in.
# Reads receipts; create a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Model for reading receipts. claude-haiku-5-5 is much cheaper - compare
# both on a few real receipts before switching.
HAUSHALT_RECEIPT_MODEL=claude-opus-5-5
HAUSHALT_RECEIPT_EFFORT=low
# PostgreSQL password, letters and digits only (it is part of a URL),
# e.g. from: openssl rand -hex 24
HAUSHALT_DB_PASSWORD=
# The HTTPS address the app is opened at, e.g. https://<machine>.<tailnet>.ts.net
HAUSHALT_PUBLIC_ORIGIN=
# Signs the login tokens. Without it a random secret is kept in the volume.
HAUSHALT_SECRET=
# Allow self-registration after the first user (default: false).
HAUSHALT_ALLOW_SIGNUP=false
# Days after purchase until receipt photos are deleted (data stays), 0 = never.
HAUSHALT_RECEIPT_PHOTO_DAYS=365
# Only with compose.lan.yaml (HTTPS in the local network, see README):
# the name and the fixed LAN address of this machine, e.g.
#   HAUSHALT_LAN_HOST=haushalt.example.home
#   HAUSHALT_LAN_IP=192.168.1.10
# and both in HAUSHALT_PUBLIC_ORIGIN, comma-separated:
#   HAUSHALT_PUBLIC_ORIGIN=https://haushalt.example.home,https://192.168.1.10
HAUSHALT_LAN_HOST=
HAUSHALT_LAN_IP=
# Port Caddy publishes on HAUSHALT_LAN_IP (default 8443).
HAUSHALT_LAN_PORT=8443
